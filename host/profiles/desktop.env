# Always-on Mac. The guest's size is measured into its manifest (4096 MiB, 1 vCPU per instance); these only gate launches.
MAX_INSTANCES=3
DAILY_BYTES=1000000000
REQUIRE_AC=0
PAUSE_ON_THERMAL=0
PAUSE_WHEN_ACTIVE=0
MIN_FREE_MIB=0
INSTRUCTIONS='Fetches and leases only. No logins or forms.'
# Public-page lease floors in credits per GB, matching guest/pack.py's measured minimum rates.
POLICY='{"categories":["price_check","research"],"floor_shared_per_gb":200,"floor_exclusive_per_gb":400,"max_minutes":120,"exclusive":true,"address":"static","notes":"no social media, under 1 GB a day"}'
