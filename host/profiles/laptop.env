# A MacBook that sleeps. One guest (4096 MiB, 1 vCPU, from its manifest), launched only on AC power, below thermal pressure,
# with MIN_FREE_MIB left for the owner after the guest's 4096, and (PAUSE_WHEN_ACTIVE=1) only after IDLE_SECONDS without input.
# A closed lid takes the guest offline mid-run; the broker marks it unreachable and buyers pay only for what was served.
MAX_INSTANCES=1
DAILY_BYTES=300000000
REQUIRE_AC=1
PAUSE_ON_THERMAL=1
PAUSE_WHEN_ACTIVE=1
IDLE_SECONDS=300
MIN_FREE_MIB=2048
INSTRUCTIONS='laptop host, may go offline. Fetches only, short leases. No logins or forms.'
POLICY='{"categories":["price_check","research"],"floor_shared_per_hour":50,"floor_exclusive_per_hour":200,"max_minutes":30,"exclusive":false,"address":"static","notes":"laptop host, may go offline; leases up to 30 min; under 300 MB a day"}'
